# Development settings: copy to backend/.env. (Installed servers are configured
# in /etc/mealplan/mealplan.env, which the installer writes for you.)

DATABASE_URL=sqlite:///./mealplan.db
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
# Set true when served over HTTPS.
COOKIE_SECURE=false
# The first account to register becomes admin. Set false afterwards to close sign-ups.
ALLOW_REGISTRATION=true
# Serve a built frontend (frontend/dist) from the API process; leave unset when using `npm run dev`.
# STATIC_DIR=../frontend/dist

# --- AI advisor (Claude) ----------------------------------------------------
ANTHROPIC_API_KEY=
ADVISOR_MODEL=claude-opus-5-5
ADVISOR_EFFORT=medium
ADVISOR_DAILY_MESSAGE_LIMIT=50

# --- Data sources -------------------------------------------------------------
# Free key: https://fdc.nal.usda.gov/api-key-signup (DEMO_KEY works but is heavily rate-limited)
USDA_FDC_API_KEY=DEMO_KEY
NIH_DSLD_ENABLED=true

# Paid / licensed sources: enabled automatically when credentials are set.
NUTRITIONIX_APP_ID=
NUTRITIONIX_APP_KEY=
EDAMAM_APP_ID=
EDAMAM_APP_KEY=

# Crowdsourced data (Open Food Facts) cannot be verified. Off by default; if
# enabled, every record from it is stored and shown as "unverified".
ENABLE_UNVERIFIED_SOURCES=false
